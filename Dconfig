mainmenu "DC-Chip configuration"

menu "Simulator"

config DC_SIM_SDB
	bool "Build the simulator debugger"
	default n
	help
	  Build support for the compact interactive simulator debugger.
	  When enabled, the simulator enters SDB after reset unless --batch is used.

config DC_SIM_WAVE
	bool "Build VCD waveform support"
	default n
	help
	  Build and enable Verilator VCD waveform recording. The simulator writes
	  one dump.vcd file in its configured build directory.

endmenu
