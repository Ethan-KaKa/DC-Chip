mainmenu "DC-Chip configuration"

menu "Simulator"

config DC_SIM_SDB
	bool "Build the simulator debugger"
	default n
	help
	  Build support for the compact interactive simulator debugger.
	  When enabled, software tests enter SDB after reset unless the sdboff
	  runtime modifier is used.

config DC_SIM_WAVE
	bool "Build VCD waveform support"
	default n
	help
	  Build and enable Verilator VCD waveform recording. The simulator writes
	  one dump.vcd file in its configured build directory.

config DC_SIM_NVBOARD
	bool "Build NVBoard graphical board simulation"
	default n
	help
	  Build and link NVBoard into the single Vsim_top simulator. Software tests
	  initialize and update the board unless the nvboardoff modifier is used.

config DC_SIM_DIFFTEST
	bool "Enable lockstep differential testing with reference model"
	default n
	help
	  Build and link the ReferenceModel and Difftest engine into the simulator.
	  When enabled, the simulator steps the reference model in lockstep with the
	  CPU for every committed instruction and checks architectural state.

endmenu
